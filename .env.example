# GitHub Personal Access Token (classic or fine-grained with read access to public repos)
# Used for issue/comment pagination and canonical reference resolution
GITHUB_TOKEN=your_github_token_here

# Ollama local endpoint configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b

# Hardware / Cache directory (optional)
HF_HOME=~/.cache/huggingface
